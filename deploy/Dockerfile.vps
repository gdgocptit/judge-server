FROM erlang:29.1.1-slim AS beam
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && curl -fsSL https://github.com/elixir-lang/elixir/releases/download/v1.20.4/elixir-otp-29.zip -o /tmp/elixir.zip \
    && echo '7863c546cda13fecc949e562e326042451dacf8fd8698a36783cb71eeb223b46  /tmp/elixir.zip' | sha256sum -c - \
    && unzip -q /tmp/elixir.zip -d /opt/elixir

# Preserved runtime image on this VPS; see README.md.
FROM dmoj/judge-tier2:runtime-base
USER root
COPY --from=beam /usr/local/lib/erlang /usr/local/lib/erlang
COPY --from=beam /opt/elixir /opt/elixir
COPY --from=beam /usr/lib/x86_64-linux-gnu/libsctp.so.1* /usr/local/lib/
RUN ln -s /usr/local/lib/erlang/bin/erl /usr/local/bin/erl \
    && ln -s /usr/local/lib/erlang/bin/escript /usr/local/bin/escript \
    && ldconfig \
    && /env/bin/python -c "import yaml; p='/judge-runtime-paths.yml'; c=yaml.safe_load(open(p)); c['runtime'].update(erl='/usr/local/bin/erl', escript='/usr/local/bin/escript', elixir='/opt/elixir/bin/elixir'); open(p,'w').write(yaml.safe_dump(c))"
ENV PATH="/opt/elixir/bin:/usr/local/bin:${PATH}"
RUN rm -rf /judge
COPY . /judge
WORKDIR /judge
RUN DMOJ_PARALLEL=2 /env/bin/pip install --no-cache-dir --no-build-isolation -e .
